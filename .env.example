# Local demo and Docker Compose. Copy to .env and set unique secrets.
DEMO_MODE=true
COLLECTION_ENABLED=false
DATABASE_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
# At least 32 bytes; generate a random value.
JWT_SECRET=
# Compatible chat-completions provider; base URL should end in /v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_URL=
AI_FALLBACK_KEY=
AI_FALLBACK_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional extended infrastructure; not used by the current collector.
RABBITMQ_PASSWORD=
MINIO_PASSWORD=
